	.long	625
	.asciz	"#version 330\r\nprecision highp float;\r\n\r\nlayout (location = 0) in vec3 aPos;\r\nlayout (location = 1) in vec2 aTex;\r\nlayout (location = 3) in vec3 iPos;\r\nlayout (location = 4) in float iTexId;\r\nlayout (location = 5) in vec2 iUVPos;\r\nlayout (location = 6) in vec2 iUVSize;\r\n\r\nuniform mat4 uPMat;\r\nuniform mat4 uMVMat;\r\nuniform mat4 uLightMat;\r\n\r\n//uniform float spFlag;\r\n\r\nout float vTexId;\r\nout vec2 vTex;\r\n\r\nvoid main()\r\n{\r\n\t// adjustment for sprites\r\n\tvec4 vPos = vec4(aPos + iPos, 1.0);\r\n\t//if (spFlag > 0.5) vPos.z = vPos.z - 0.1;\r\n\t// calculate position\r\n\tgl_Position = uPMat * uLightMat * uMVMat * vPos; \r\n\tvTex = aTex;\r\n}"
	.zero	2

	.globl	_sz1
	.p2align	4, 0x0
_sz1:
	.long	308
	.asciz	"#version 330\r\nprecision mediump float;\r\nprecision mediump sampler2DArray;\r\n\r\nin float vTexId;\r\nin vec2 vTex;\r\n\r\nuniform sampler2DArray uSampler;\r\n\r\nout vec4 gColor;\r\n\r\nvoid main()\r\n{\r\n\tfloat alpha = texture(uSampler, vec3(vTex, vTexId)).a;\r\n\tif (alpha == 0.0) discard;\r\n\tgColor = vec4(0.6, 0.6, 0.6, 1.0);\r\n}"
	.zero	3

	.globl	_sz2
