	.asciz	"#version 330\r\nprecision mediump float;\r\nprecision mediump sampler2DArray;\r\n\r\nin float vTexId;\r\nin vec2 vTex;\r\n\r\nuniform sampler2DArray uSampler;\r\n\r\nout vec4 gColor;\r\n\r\nvoid main()\r\n{\r\n\tfloat alpha = texture(uSampler, vec3(vTex, vTexId)).a;\r\n\tif (alpha == 0.0) discard;\r\n\tgColor = vec4(0.6, 0.6, 0.6, 1.0);\r\n}"
